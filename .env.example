# Default: sample adapter (no network, no keys — this is the OSS demo)
VITE_ADAPTER=sample

# ── Live ensemble API ─────────────────────────────────────────────────────────
# VITE_ADAPTER=http
#
# VITE_HTTP_BASE_URL is what the browser fetches. Leave it EMPTY to fetch
# same-origin (/api/...) and let the dev server proxy — this is the setup that
# works, because a backend on another port will be blocked by CORS unless that
# server sends Access-Control-Allow-Origin, which the local Alignment server
# does not.
# VITE_HTTP_BASE_URL=
#
# Dev server only: where same-origin /api requests are forwarded.
# VITE_HTTP_PROXY_TARGET=http://127.0.0.1:3001
#
# VITE_HTTP_TOKEN=
